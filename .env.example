# Copy to .env and fill in. Never commit .env.

# Django
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# Docker Compose: POSTGRES_HOST=db. Local Postgres: 127.0.0.1
POSTGRES_DB=hims
POSTGRES_USER=hims
POSTGRES_PASSWORD=hims_dev_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgres://hims:hims_dev_password@127.0.0.1:5432/hims

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# false = LocMemCache (local without Redis). true with Docker Compose + Redis.
USE_REDIS_CACHE=false

# Session
SESSION_COOKIE_AGE=1800
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Seed (refused when DEBUG=false unless --force)
DEMO_SEED_PASSWORD=ChangeMeDemo!2026

# Media
MEDIA_ROOT=./backend/media
